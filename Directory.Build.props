<Project>

  <PropertyGroup>
    <!-- The product name lives here and nowhere else: code reads it through AppIdentity.Name. -->
    <AppName>Sulap</AppName>
    <Product>$(AppName)</Product>
    <Version>0.2.0</Version>
    <Copyright>Copyright (c) 2026 erawandavid</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Lets the Windows-only projects build on other systems too. They only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published advisory for a dependency shouldn't break every build; it still shows as a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <SatelliteResourceLanguages>en;id</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AppName" Value="$(AppName)" />
  </ItemGroup>

</Project>
