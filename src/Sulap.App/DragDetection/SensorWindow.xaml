<Window x:Class="Sulap.App.DragDetection.SensorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="280"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True">
  <!-- Alpha 1 instead of 0: Windows lets drags and clicks fall through fully transparent pixels. -->
  <Grid Background="#01000000">
    <Ellipse x:Name="Tint" Fill="#550078D4" Stroke="#CC0078D4" StrokeThickness="2" Visibility="Collapsed" />
  </Grid>
</Window>
