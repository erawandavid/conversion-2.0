<Window x:Class="Sulap.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title=""
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <!-- The 16 px margin is room for the shadow. -->
  <Grid Margin="16">
    <!-- The shadow has a layer of its own: an effect on the card would also soften its text. -->
    <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.26" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1">
      <Grid Margin="16,14,8,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="KindIcon" Margin="0,2,12,0" VerticalAlignment="Top"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Top"
                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button x:Name="CloseButton" Grid.Column="2" Width="32" Height="28" Margin="0,-6,0,0" Padding="0"
                VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"
                ToolTip="Close" Click="OnCloseClick" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,8,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ProgressBar x:Name="ProgressIndicator" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,8,2" Maximum="100" />
        <StackPanel x:Name="ActionsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal" />
      </Grid>
    </Border>
  </Grid>
</Window>
